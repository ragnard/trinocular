{
  "name": "monaco-language-trino",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc && vite build",
    "build:lib": "rm -rf dist && vite build && tsc -p tsconfig.lib.json",
    "build:grammar": "antlr-ng -Dlanguage=TypeScript -l -v -o src/parser grammar/SqlBase.g4"
  },
  "peerDependencies": {
    "monaco-editor": ">=0.30.0"
  },
  "devDependencies": {
    "antlr-ng": "^1.0.10",
    "monaco-editor": "^0.55.1",
    "typescript": "^5.9.3",
    "vite": "^7.1.11"
  },
  "dependencies": {
    "antlr4-c3": "^3.4.4",
    "antlr4ng": "^3.0.16"
  }
}
