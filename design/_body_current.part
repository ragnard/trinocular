
<div class="now-dark" style="position:relative;width:1440px;height:900px;background:var(--bg-0);color:var(--text-0);font-size:16px;line-height:1;display:grid;grid-template-columns:360px 2px 1fr">

  <!-- ============ schema browser (left) ============ -->
  <div style="background:var(--bg-1);display:flex;flex-direction:column;min-height:0">
    <div style="padding:9.6px 16px;border-bottom:1px solid var(--border)">
      <div style="display:flex;align-items:center;gap:6.4px;font-weight:700">
        <span style="width:32px;height:32px;border-radius:50%;border:1px solid var(--border);background:var(--bg-0);display:inline-flex;align-items:center;justify-content:center;font-size:16px">&#128055;</span>
        Oink
      </div>
    </div>

    <div style="display:flex;align-items:center;gap:6.4px;margin:9.6px 12px 5.6px;padding:0 8px;border:1px solid var(--border);border-radius:4px;background:var(--bg-0);color:var(--text-2)">
      <svg class="ic"><use href="#i-search"/></svg>
      <span style="flex:1;padding:5.6px 0;font-size:16px;color:var(--text-2)">Filter&hellip;</span>
    </div>

    <div style="display:flex;align-items:center;justify-content:space-between;gap:8px;padding:6.4px 14.4px 8px;color:var(--text-2);font-size:13.6px">
      <span style="font-weight:700;text-transform:uppercase">Schema</span>
      <span style="display:inline-flex;align-items:center;gap:4px"><svg class="ic12"><use href="#i-db"/></svg>analytics-prod</span>
    </div>

    <div style="flex:1;min-height:0;overflow:hidden;padding:0 12px 12px">
      <div style="display:flex;align-items:center;gap:4px;padding:4px;border-radius:3px"><svg class="ic16" style="transform:rotate(90deg)"><use href="#i-right"/></svg><svg class="ic16"><use href="#i-db"/></svg>tpch</div>
      <div style="padding-left:12px">
        <div style="display:flex;align-items:center;gap:4px;padding:4px;border-radius:3px"><svg class="ic16"><use href="#i-right"/></svg><svg class="ic16"><use href="#i-box"/></svg>sf1</div>
        <div style="display:flex;align-items:center;gap:4px;padding:4px;border-radius:3px"><svg class="ic16" style="transform:rotate(90deg)"><use href="#i-right"/></svg><svg class="ic16"><use href="#i-box"/></svg>sf100</div>
        <div style="padding-left:12px">
          <div style="display:flex;align-items:center;gap:4px;padding:4px;border-radius:3px"><svg class="ic16"><use href="#i-right"/></svg><svg class="ic16"><use href="#i-table"/></svg>customer</div>
          <div style="display:flex;align-items:center;gap:4px;padding:4px;border-radius:3px;background:var(--bg-focus)"><svg class="ic16" style="transform:rotate(90deg)"><use href="#i-right"/></svg><svg class="ic16"><use href="#i-table"/></svg>lineitem</div>
          <div style="padding-left:12px">
            <div style="display:flex;align-items:center;gap:4px;padding:4px"><svg class="ic16" style="opacity:0"><use href="#i-right"/></svg><svg class="ic16"><use href="#i-type"/></svg>orderkey<span style="color:var(--text-2);font-size:13.6px;margin-left:4px">bigint</span></div>
            <div style="display:flex;align-items:center;gap:4px;padding:4px"><svg class="ic16" style="opacity:0"><use href="#i-right"/></svg><svg class="ic16"><use href="#i-type"/></svg>partkey<span style="color:var(--text-2);font-size:13.6px;margin-left:4px">bigint</span></div>
            <div style="display:flex;align-items:center;gap:4px;padding:4px"><svg class="ic16" style="opacity:0"><use href="#i-right"/></svg><svg class="ic16"><use href="#i-type"/></svg>extendedprice<span style="color:var(--text-2);font-size:13.6px;margin-left:4px">double</span></div>
            <div style="display:flex;align-items:center;gap:4px;padding:4px"><svg class="ic16" style="opacity:0"><use href="#i-right"/></svg><svg class="ic16"><use href="#i-type"/></svg>discount<span style="color:var(--text-2);font-size:13.6px;margin-left:4px">double</span></div>
            <div style="display:flex;align-items:center;gap:4px;padding:4px"><svg class="ic16" style="opacity:0"><use href="#i-right"/></svg><svg class="ic16"><use href="#i-type"/></svg>shipdate<span style="color:var(--text-2);font-size:13.6px;margin-left:4px">date</span></div>
          </div>
          <div style="display:flex;align-items:center;gap:4px;padding:4px"><svg class="ic16"><use href="#i-right"/></svg><svg class="ic16"><use href="#i-table"/></svg>orders</div>
          <div style="display:flex;align-items:center;gap:4px;padding:4px"><svg class="ic16"><use href="#i-right"/></svg><svg class="ic16"><use href="#i-table"/></svg>nation</div>
        </div>
        <div style="display:flex;align-items:center;gap:4px;padding:4px"><svg class="ic16"><use href="#i-right"/></svg><svg class="ic16"><use href="#i-box"/></svg>tiny</div>
      </div>
      <div style="display:flex;align-items:center;gap:4px;padding:4px"><svg class="ic16"><use href="#i-right"/></svg><svg class="ic16"><use href="#i-db"/></svg>iceberg</div>
      <div style="display:flex;align-items:center;gap:4px;padding:4px"><svg class="ic16"><use href="#i-right"/></svg><svg class="ic16"><use href="#i-db"/></svg>hive</div>
      <div style="display:flex;align-items:center;gap:4px;padding:4px"><svg class="ic16"><use href="#i-right"/></svg><svg class="ic16"><use href="#i-db"/></svg>system</div>
    </div>

    <div style="border-top:1px solid var(--border);padding:9.6px 16px;display:flex;align-items:center;gap:8px">
      <span style="border:1px solid var(--border);border-radius:4px;padding:3.2px 6.4px;display:inline-flex;color:var(--text-2)"><svg class="ic16"><use href="#i-moon"/></svg></span>
      <span style="font-size:13.6px;color:var(--text-2)">r.dahlen@gmail.com</span>
    </div>
  </div>

  <div style="background:var(--border-dark)"></div>

  <!-- ============ right of first split ============ -->
  <div style="display:grid;grid-template-columns:1fr 2px 268px;min-width:0">

    <!-- document -->
    <div style="display:flex;flex-direction:column;min-width:0;min-height:0">
      <!-- document header : 40px -->
      <div style="height:40px;display:flex;align-items:center;gap:4px;padding:0 12px;background:var(--bg-1);border-bottom:1px solid var(--border);flex:none">
        <span style="display:inline-flex;align-items:center;gap:5.6px;padding:4px 7.2px;border-radius:4px;font-size:13.6px;font-weight:600"><svg class="ic" style="color:var(--text-2)"><use href="#i-file"/></svg>revenue-by-nation.sql<svg class="ic12" style="color:var(--text-2)"><use href="#i-down"/></svg></span>
        <span style="width:1px;height:16px;background:var(--border);margin:0 4px"></span>
        <span style="display:inline-flex;align-items:center;gap:5.6px;padding:4px 7.2px;border-radius:4px;font-size:13.6px"><svg class="ic" style="color:var(--text-2)"><use href="#i-db"/></svg>analytics-prod<svg class="ic12" style="color:var(--text-2)"><use href="#i-down"/></svg></span>
        <span style="flex:1"></span>
        <span style="display:inline-flex;align-items:center;gap:6.4px;font-size:13.6px;color:var(--text-2)"><kbd style="border:1px solid var(--border);border-radius:3px;background:var(--bg-0);padding:.05em .35em;font:inherit;font-size:11.56px">&#8984;P</kbd>Switch file</span>
      </div>

      <!-- editor : 263px -->
      <div style="height:263px;background:var(--bg-0);overflow:hidden;flex:none;position:relative">
        <div class="mono" style="font-size:14px;line-height:19px;padding:8px 0">
          <div style="color:var(--text-2);padding-left:18px;font-size:13px">&#9654; Run&nbsp;&nbsp;&nbsp;&nbsp;&#9776; Results&nbsp;&nbsp;&nbsp;&nbsp;200 rows</div>
          <div style="display:flex"><span style="width:44px;text-align:right;padding-right:14px;color:#5a5a5a">1</span><span><span style="color:#569cd6">select</span></span></div>
          <div style="display:flex"><span style="width:44px;text-align:right;padding-right:14px;color:#5a5a5a">2</span><span>&nbsp;&nbsp;&nbsp;&nbsp;<span style="color:#9cdcfe">n</span>.<span style="color:#9cdcfe">name</span> <span style="color:#569cd6">as</span> <span style="color:#9cdcfe">nation</span>,</span></div>
          <div style="display:flex"><span style="width:44px;text-align:right;padding-right:14px;color:#5a5a5a">3</span><span>&nbsp;&nbsp;&nbsp;&nbsp;<span style="color:#dcdcaa">count</span>(<span style="color:#569cd6">distinct</span> <span style="color:#9cdcfe">o</span>.<span style="color:#9cdcfe">orderkey</span>) <span style="color:#569cd6">as</span> <span style="color:#9cdcfe">orders</span>,</span></div>
          <div style="display:flex"><span style="width:44px;text-align:right;padding-right:14px;color:#5a5a5a">4</span><span>&nbsp;&nbsp;&nbsp;&nbsp;<span style="color:#dcdcaa">sum</span>(<span style="color:#9cdcfe">l</span>.<span style="color:#9cdcfe">extendedprice</span> * (<span style="color:#b5cea8">1</span> - <span style="color:#9cdcfe">l</span>.<span style="color:#9cdcfe">discount</span>)) <span style="color:#569cd6">as</span> <span style="color:#9cdcfe">revenue</span></span></div>
          <div style="display:flex"><span style="width:44px;text-align:right;padding-right:14px;color:#5a5a5a">5</span><span><span style="color:#569cd6">from</span> <span style="color:#9cdcfe">tpch</span>.<span style="color:#9cdcfe">sf100</span>.<span style="color:#9cdcfe">lineitem</span> <span style="color:#9cdcfe">l</span></span></div>
          <div style="display:flex"><span style="width:44px;text-align:right;padding-right:14px;color:#5a5a5a">6</span><span><span style="color:#569cd6">join</span> <span style="color:#9cdcfe">tpch</span>.<span style="color:#9cdcfe">sf100</span>.<span style="color:#9cdcfe">orders</span> <span style="color:#9cdcfe">o</span> <span style="color:#569cd6">on</span> <span style="color:#9cdcfe">o</span>.<span style="color:#9cdcfe">orderkey</span> = <span style="color:#9cdcfe">l</span>.<span style="color:#9cdcfe">orderkey</span></span></div>
          <div style="display:flex"><span style="width:44px;text-align:right;padding-right:14px;color:#5a5a5a">7</span><span><span style="color:#569cd6">join</span> <span style="color:#9cdcfe">tpch</span>.<span style="color:#9cdcfe">sf100</span>.<span style="color:#9cdcfe">customer</span> <span style="color:#9cdcfe">c</span> <span style="color:#569cd6">on</span> <span style="color:#9cdcfe">c</span>.<span style="color:#9cdcfe">custkey</span> = <span style="color:#9cdcfe">o</span>.<span style="color:#9cdcfe">custkey</span></span></div>
          <div style="display:flex"><span style="width:44px;text-align:right;padding-right:14px;color:#5a5a5a">8</span><span><span style="color:#569cd6">join</span> <span style="color:#9cdcfe">tpch</span>.<span style="color:#9cdcfe">sf100</span>.<span style="color:#9cdcfe">nation</span> <span style="color:#9cdcfe">n</span> <span style="color:#569cd6">on</span> <span style="color:#9cdcfe">n</span>.<span style="color:#9cdcfe">nationkey</span> = <span style="color:#9cdcfe">c</span>.<span style="color:#9cdcfe">nationkey</span></span></div>
          <div style="display:flex"><span style="width:44px;text-align:right;padding-right:14px;color:#5a5a5a">9</span><span><span style="color:#569cd6">where</span> <span style="color:#9cdcfe">o</span>.<span style="color:#9cdcfe">orderdate</span> &gt;= <span style="color:#569cd6">date</span> <span style="color:#ce9178">'1995-01-01'</span></span></div>
          <div style="display:flex"><span style="width:44px;text-align:right;padding-right:14px;color:#5a5a5a">10</span><span><span style="color:#569cd6">group by</span> <span style="color:#b5cea8">1</span> <span style="color:#569cd6">order by</span> <span style="color:#9cdcfe">revenue</span> <span style="color:#569cd6">desc</span>;</span></div>
        </div>
      </div>

