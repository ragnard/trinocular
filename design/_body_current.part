          <tr><td style="height:28px;padding:0 8px;font-size:12px;text-align:right;color:var(--text-2);background:var(--bg-1);border-right:1px solid var(--border);border-bottom:1px solid var(--border)">4</td><td style="height:28px;padding:0 8px;border-right:1px solid var(--border);border-bottom:1px solid var(--border)">CHINA</td><td style="height:28px;padding:0 8px;border-right:1px solid var(--border);border-bottom:1px solid var(--border)">599 940</td><td style="height:28px;padding:0 8px;border-right:1px solid var(--border);border-bottom:1px solid var(--border)">9 065 000 021.14</td><td style="border-bottom:1px solid var(--border)"></td></tr>
