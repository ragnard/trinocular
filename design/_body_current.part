            <th style="width:230px;background:var(--bg-1);border-right:1px solid var(--border);border-bottom:1px solid var(--border);padding:4px 8px;text-align:left"><div style="padding:6.4px 3.2px"><div style="font-size:13.6px;text-transform:uppercase">nation</div><div style="font-size:13.6px;color:var(--text-2)">varchar(25)</div></div></th>
