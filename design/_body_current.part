          <tr><td style="height:28px;padding:0 8px;font-size:12px;text-align:right;color:var(--text-2);background:var(--bg-1);border-right:1px solid var(--border);border-bottom:1px solid var(--border)">2</td><td style="height:28px;padding:0 8px;border-right:1px solid var(--border);border-bottom:1px solid var(--border)">BRAZIL</td><td style="height:28px;padding:0 8px;border-right:1px solid var(--border);border-bottom:1px solid var(--border)">601 077</td><td style="height:28px;padding:0 8px;border-right:1px solid var(--border);border-bottom:1px solid var(--border)">9 087 445 021.08</td><td style="border-bottom:1px solid var(--border)"></td></tr>
