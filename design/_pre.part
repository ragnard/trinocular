<!doctype html>
<html>
<head>
  <meta charset="utf-8">
  <script src="./support.js"></script>
</head>
<body>
<x-dc>
<helmet>
  <style>
    /* Current tokens, resolved from the app's oklch relative colors -------- */
    .now-dark{
      --bg-0:#1e1e1e; --bg-1:#262626; --bg-2:#2e2e2e; --bg-focus:#454545;
      --text-0:#c4c4c4; --text-2:#767676;
      --border:#414141; --border-dark:#303030;
      --accent:#4da6ff; --accent-bg:rgba(77,166,255,.15); --error:#f47067;
    }
    .now-light{
      --bg-0:#ffffff; --bg-1:#f0f0f0; --bg-2:#f5f5f5; --bg-focus:#d8d8d8;
      --text-0:#000000; --text-2:#999999;
      --border:#e0e0e0; --border-dark:#cccccc;
      --accent:#0e65eb; --accent-bg:rgba(14,101,235,.12); --error:#cf222e;
    }
    /* Proposed tokens: one monotonic elevation ramp, same meaning in both --- */
    .dark{
      --s0:#1e1e1e; --s1:#252527; --s2:#2e2e31; --s3:#3a3a3e;
      --line:#303033; --line-strong:#3f3f44;
      --fg:#cfcfd2; --fg-2:#96969c; --fg-3:#6e6e75;
      --accent:#4da6ff; --accent-fg:#0d1a26;
      --accent-bg:rgba(77,166,255,.16); --accent-line:rgba(77,166,255,.55);
      --ok:#5ec9a8; --warn:#e2b341; --error:#f47067; --error-bg:rgba(244,112,103,.13);
      --kw:#569cd6; --str:#ce9178; --num:#b5cea8; --fn:#dcdcaa; --id:#9cdcfe; --cmt:#6a9955;
      --shadow:0 10px 30px rgba(0,0,0,.45), 0 2px 6px rgba(0,0,0,.3);
    }
    .light{
      --s0:#ffffff; --s1:#f7f7f8; --s2:#eeeef1; --s3:#e3e3e8;
      --line:#e8e8ec; --line-strong:#d6d6dc;
      --fg:#1f2024; --fg-2:#6b6c74; --fg-3:#8f9099;
      --accent:#0e65eb; --accent-fg:#ffffff;
      --accent-bg:rgba(14,101,235,.10); --accent-line:rgba(14,101,235,.45);
      --ok:#1a7f5a; --warn:#9a6700; --error:#cf222e; --error-bg:rgba(207,34,46,.09);
      --kw:#0000c0; --str:#a31515; --num:#098658; --fn:#795e26; --id:#0b5c8a; --cmt:#3a8a3a;
      --shadow:0 10px 28px rgba(15,18,25,.14), 0 2px 6px rgba(15,18,25,.07);
    }
    /* Warm variant used by the Cards direction */
    .warm{
      --s0:#fdfcfb; --s1:#f6f4f1; --s2:#edeae5; --s3:#e2ded7;
      --line:#eae7e2; --line-strong:#d9d5ce;
      --fg:#25231f; --fg-2:#6d6960; --fg-3:#938e84;
      --accent:#1f6feb; --accent-fg:#ffffff;
      --accent-bg:rgba(31,111,235,.10); --accent-line:rgba(31,111,235,.4);
      --ok:#1a7f5a; --warn:#9a6700; --error:#c0392b; --error-bg:rgba(192,57,43,.09);
      --kw:#1d4ed8; --str:#9a3412; --num:#0f766e; --fn:#7c5a12; --id:#0f5d80; --cmt:#6b8f5f;
      --shadow:0 12px 32px rgba(60,50,35,.10), 0 2px 6px rgba(60,50,35,.06);
    }

    *{box-sizing:border-box;margin:0}
    body{
      margin:0;
      font-family:ui-sans-serif,system-ui,-apple-system,"Segoe UI",Roboto,"Helvetica Neue",sans-serif;
      font-size:13px; line-height:20px;
      -webkit-font-smoothing:antialiased;
    }
    a{color:var(--accent);text-decoration:none}
    a:hover{color:var(--accent);text-decoration:underline}
    .mono{font-family:ui-monospace,"SF Mono",Menlo,Consolas,"Liberation Mono",monospace}
    .ic{width:14px;height:14px;flex:none;stroke:currentColor;fill:none;stroke-width:1.75;stroke-linecap:round;stroke-linejoin:round}
    .ic12{width:12px;height:12px;flex:none;stroke:currentColor;fill:none;stroke-width:1.9;stroke-linecap:round;stroke-linejoin:round}
    .ic16{width:16px;height:16px;flex:none;stroke:currentColor;fill:none;stroke-width:1.65;stroke-linecap:round;stroke-linejoin:round}
    .meta{font-size:11px;line-height:16px}
    .caps{font-size:11px;line-height:16px;letter-spacing:.055em;text-transform:uppercase;font-weight:600}
    .num{font-variant-numeric:tabular-nums}
    .row{display:flex;align-items:center}
    .ell{min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
  </style>
</helmet>
