
<div class="dark" style="width:1440px;height:900px;background:var(--s0);color:var(--fg);display:grid;grid-template-rows:36px 1fr 26px">

  <!-- ================= one 36px rail band across the whole top ================= -->
  <div style="display:grid;grid-template-columns:264px 1px 1fr;background:var(--s1);border-bottom:1px solid var(--line-strong)">

    <!-- left rail: the filter IS the header -->
    <div style="display:flex;align-items:center;gap:8px;padding:0 10px 0 12px;color:var(--fg-3)">
      <svg class="ic"><use href="#i-search"/></svg>
      <span style="flex:1;color:var(--fg-3)">Filter schema&hellip;</span>
      <span style="display:inline-flex;align-items:center;justify-content:center;width:24px;height:24px;border-radius:6px;color:var(--fg-3)"><svg class="ic"><use href="#i-rows"/></svg></span>
    </div>

    <div style="background:var(--line-strong)"></div>

    <!-- document rail -->
    <div style="display:flex;align-items:center;gap:2px;padding:0 12px">
      <span style="display:inline-flex;align-items:center;gap:6px;height:24px;padding:0 8px;border-radius:6px;background:var(--s2);font-weight:600"><svg class="ic" style="color:var(--fg-3)"><use href="#i-file"/></svg>revenue-by-nation.sql<svg class="ic12" style="color:var(--fg-3)"><use href="#i-down"/></svg></span>
      <span style="width:1px;height:16px;background:var(--line-strong);margin:0 8px"></span>
      <span style="display:inline-flex;align-items:center;gap:6px;height:24px;padding:0 8px;border-radius:6px;color:var(--fg-2)"><svg class="ic" style="color:var(--fg-3)"><use href="#i-db"/></svg>analytics-prod<svg class="ic12" style="color:var(--fg-3)"><use href="#i-down"/></svg></span>
      <span style="flex:1"></span>
      <span style="display:inline-flex;align-items:center;gap:6px;color:var(--fg-3)"><kbd class="meta" style="border:1px solid var(--line-strong);border-radius:4px;background:var(--s0);padding:1px 5px;font-family:inherit">&#8984;P</kbd>Switch file</span>
    </div>
  </div>

  <!-- ================= body ================= -->
  <div style="display:grid;grid-template-columns:264px 1px 1fr;min-height:0">

    <!-- ---------- schema browser ---------- -->
    <div style="background:var(--s1);display:flex;flex-direction:column;min-height:0;padding:8px 8px 8px 8px">
      <div class="row meta" style="gap:6px;height:26px;padding:0 8px;color:var(--fg-3);flex:none">
        <svg class="ic12"><use href="#i-db"/></svg><span style="flex:1">analytics-prod</span>
      </div>

      <div style="flex:1;min-height:0;overflow:hidden">
        <div class="row" style="gap:6px;height:26px;padding:0 8px;border-radius:6px"><svg class="ic12" style="color:var(--fg-3);transform:rotate(90deg)"><use href="#i-right"/></svg><svg class="ic" style="color:var(--fg-3)"><use href="#i-db"/></svg><span class="ell">tpch</span></div>
        <div style="padding-left:14px">
          <div class="row" style="gap:6px;height:26px;padding:0 8px;border-radius:6px"><svg class="ic12" style="color:var(--fg-3)"><use href="#i-right"/></svg><svg class="ic" style="color:var(--fg-3)"><use href="#i-box"/></svg><span class="ell">sf1</span></div>
          <div class="row" style="gap:6px;height:26px;padding:0 8px;border-radius:6px"><svg class="ic12" style="color:var(--fg-3);transform:rotate(90deg)"><use href="#i-right"/></svg><svg class="ic" style="color:var(--fg-3)"><use href="#i-box"/></svg><span class="ell">sf100</span></div>
          <div style="padding-left:14px">
            <div class="row" style="gap:6px;height:26px;padding:0 8px;border-radius:6px"><svg class="ic12" style="color:var(--fg-3)"><use href="#i-right"/></svg><svg class="ic" style="color:var(--fg-3)"><use href="#i-table"/></svg><span class="ell">customer</span></div>
            <div class="row" style="gap:6px;height:26px;padding:0 8px;border-radius:6px;background:var(--accent-bg);box-shadow:inset 2px 0 0 var(--accent)"><svg class="ic12" style="color:var(--fg-3);transform:rotate(90deg)"><use href="#i-right"/></svg><svg class="ic" style="color:var(--accent)"><use href="#i-table"/></svg><span class="ell">lineitem</span></div>
            <div style="padding-left:14px">
              <div class="row" style="gap:6px;height:26px;padding:0 8px"><span style="width:12px"></span><svg class="ic" style="color:var(--fg-3)"><use href="#i-type"/></svg><span class="ell" style="flex:1">orderkey</span><span class="meta" style="color:var(--fg-3)">bigint</span></div>
              <div class="row" style="gap:6px;height:26px;padding:0 8px"><span style="width:12px"></span><svg class="ic" style="color:var(--fg-3)"><use href="#i-type"/></svg><span class="ell" style="flex:1">partkey</span><span class="meta" style="color:var(--fg-3)">bigint</span></div>
              <div class="row" style="gap:6px;height:26px;padding:0 8px"><span style="width:12px"></span><svg class="ic" style="color:var(--fg-3)"><use href="#i-type"/></svg><span class="ell" style="flex:1">extendedprice</span><span class="meta" style="color:var(--fg-3)">double</span></div>
              <div class="row" style="gap:6px;height:26px;padding:0 8px"><span style="width:12px"></span><svg class="ic" style="color:var(--fg-3)"><use href="#i-type"/></svg><span class="ell" style="flex:1">discount</span><span class="meta" style="color:var(--fg-3)">double</span></div>
              <div class="row" style="gap:6px;height:26px;padding:0 8px"><span style="width:12px"></span><svg class="ic" style="color:var(--fg-3)"><use href="#i-type"/></svg><span class="ell" style="flex:1">shipdate</span><span class="meta" style="color:var(--fg-3)">date</span></div>
              <div class="row" style="gap:6px;height:26px;padding:0 8px"><span style="width:12px"></span><svg class="ic" style="color:var(--fg-3)"><use href="#i-type"/></svg><span class="ell" style="flex:1">returnflag</span><span class="meta" style="color:var(--fg-3)">varchar(1)</span></div>
            </div>
            <div class="row" style="gap:6px;height:26px;padding:0 8px;border-radius:6px;background:var(--s2)"><svg class="ic12" style="color:var(--fg-3)"><use href="#i-right"/></svg><svg class="ic" style="color:var(--fg-3)"><use href="#i-table"/></svg><span class="ell">orders</span></div>
            <div class="row" style="gap:6px;height:26px;padding:0 8px;border-radius:6px"><svg class="ic12" style="color:var(--fg-3)"><use href="#i-right"/></svg><svg class="ic" style="color:var(--fg-3)"><use href="#i-table"/></svg><span class="ell">nation</span></div>
            <div class="row" style="gap:6px;height:26px;padding:0 8px;border-radius:6px"><svg class="ic12" style="color:var(--fg-3)"><use href="#i-right"/></svg><svg class="ic" style="color:var(--fg-3)"><use href="#i-table"/></svg><span class="ell">region</span></div>
            <div class="row" style="gap:6px;height:26px;padding:0 8px;border-radius:6px"><svg class="ic12" style="color:var(--fg-3)"><use href="#i-right"/></svg><svg class="ic" style="color:var(--fg-3)"><use href="#i-table"/></svg><span class="ell">supplier</span></div>
          </div>
          <div class="row" style="gap:6px;height:26px;padding:0 8px;border-radius:6px"><svg class="ic12" style="color:var(--fg-3)"><use href="#i-right"/></svg><svg class="ic" style="color:var(--fg-3)"><use href="#i-box"/></svg><span class="ell">tiny</span></div>
        </div>
        <div class="row" style="gap:6px;height:26px;padding:0 8px;border-radius:6px"><svg class="ic12" style="color:var(--fg-3)"><use href="#i-right"/></svg><svg class="ic" style="color:var(--fg-3)"><use href="#i-db"/></svg><span class="ell">iceberg</span></div>
        <div class="row" style="gap:6px;height:26px;padding:0 8px;border-radius:6px"><svg class="ic12" style="color:var(--fg-3)"><use href="#i-right"/></svg><svg class="ic" style="color:var(--fg-3)"><use href="#i-db"/></svg><span class="ell">hive</span></div>
        <div class="row" style="gap:6px;height:26px;padding:0 8px;border-radius:6px"><svg class="ic12" style="color:var(--fg-3)"><use href="#i-right"/></svg><svg class="ic" style="color:var(--fg-3)"><use href="#i-db"/></svg><span class="ell">system</span></div>
      </div>
    </div>

    <div style="background:var(--line-strong)"></div>

    <!-- ---------- document body: editor over results ---------- -->
    <div style="display:grid;grid-template-rows:360px 1px 1fr;min-width:0;min-height:0">

      <!-- editor -->
      <div style="background:var(--s0);overflow:hidden;position:relative;padding:10px 0 0">
        <!-- statement strip -->
        <div class="row" style="gap:14px;height:22px;padding-left:60px;color:var(--fg-3)">
          <span class="row" style="gap:6px;color:var(--accent)"><svg class="ic12"><use href="#i-play"/></svg>Run</span>
          <span class="row" style="gap:6px"><svg class="ic12"><use href="#i-list"/></svg>200 rows</span>
        </div>
        <div class="mono" style="font-size:13px;line-height:22px;position:relative">
          <div style="position:absolute;left:52px;top:0;bottom:0;width:2px;background:var(--accent);opacity:.55;border-radius:1px"></div>
          <div style="display:flex"><span class="num" style="width:44px;text-align:right;padding-right:16px;color:var(--fg-3)">1</span><span style="padding-left:16px"><span style="color:var(--kw)">select</span></span></div>
          <div style="display:flex"><span class="num" style="width:44px;text-align:right;padding-right:16px;color:var(--fg-3)">2</span><span style="padding-left:16px">&nbsp;&nbsp;<span style="color:var(--id)">n</span>.<span style="color:var(--id)">name</span> <span style="color:var(--kw)">as</span> <span style="color:var(--id)">nation</span>,</span></div>
          <div style="display:flex"><span class="num" style="width:44px;text-align:right;padding-right:16px;color:var(--fg-3)">3</span><span style="padding-left:16px">&nbsp;&nbsp;<span style="color:var(--fn)">count</span>(<span style="color:var(--kw)">distinct</span> <span style="color:var(--id)">o</span>.<span style="color:var(--id)">orderkey</span>) <span style="color:var(--kw)">as</span> <span style="color:var(--id)">orders</span>,</span></div>
          <div style="display:flex"><span class="num" style="width:44px;text-align:right;padding-right:16px;color:var(--fg-3)">4</span><span style="padding-left:16px">&nbsp;&nbsp;<span style="color:var(--fn)">count</span>(<span style="color:var(--kw)">distinct</span> <span style="color:var(--id)">c</span>.<span style="color:var(--id)">custkey</span>) <span style="color:var(--kw)">as</span> <span style="color:var(--id)">customers</span>,</span></div>
          <div style="display:flex"><span class="num" style="width:44px;text-align:right;padding-right:16px;color:var(--fg-3)">5</span><span style="padding-left:16px">&nbsp;&nbsp;<span style="color:var(--fn)">sum</span>(<span style="color:var(--id)">l</span>.<span style="color:var(--id)">extendedprice</span> * (<span style="color:var(--num)">1</span> - <span style="color:var(--id)">l</span>.<span style="color:var(--id)">discount</span>)) <span style="color:var(--kw)">as</span> <span style="color:var(--id)">revenue</span>,</span></div>
          <div style="display:flex"><span class="num" style="width:44px;text-align:right;padding-right:16px;color:var(--fg-3)">6</span><span style="padding-left:16px">&nbsp;&nbsp;<span style="color:var(--fn)">avg</span>(<span style="color:var(--fn)">date_diff</span>(<span style="color:var(--str)">'day'</span>, <span style="color:var(--id)">o</span>.<span style="color:var(--id)">orderdate</span>, <span style="color:var(--id)">l</span>.<span style="color:var(--id)">shipdate</span>)) <span style="color:var(--kw)">as</span> <span style="color:var(--id)">avg_ship_days</span></span></div>
          <div style="display:flex"><span class="num" style="width:44px;text-align:right;padding-right:16px;color:var(--fg-3)">7</span><span style="padding-left:16px"><span style="color:var(--kw)">from</span> <span style="color:var(--id)">tpch</span>.<span style="color:var(--id)">sf100</span>.<span style="color:var(--id)">lineitem</span> <span style="color:var(--id)">l</span></span></div>
          <div style="display:flex"><span class="num" style="width:44px;text-align:right;padding-right:16px;color:var(--fg-3)">8</span><span style="padding-left:16px">&nbsp;&nbsp;<span style="color:var(--kw)">join</span> <span style="color:var(--id)">tpch</span>.<span style="color:var(--id)">sf100</span>.<span style="color:var(--id)">orders</span> <span style="color:var(--id)">o</span> <span style="color:var(--kw)">on</span> <span style="color:var(--id)">o</span>.<span style="color:var(--id)">orderkey</span> = <span style="color:var(--id)">l</span>.<span style="color:var(--id)">orderkey</span></span></div>
          <div style="display:flex"><span class="num" style="width:44px;text-align:right;padding-right:16px;color:var(--fg-3)">9</span><span style="padding-left:16px">&nbsp;&nbsp;<span style="color:var(--kw)">join</span> <span style="color:var(--id)">tpch</span>.<span style="color:var(--id)">sf100</span>.<span style="color:var(--id)">customer</span> <span style="color:var(--id)">c</span> <span style="color:var(--kw)">on</span> <span style="color:var(--id)">c</span>.<span style="color:var(--id)">custkey</span> = <span style="color:var(--id)">o</span>.<span style="color:var(--id)">custkey</span></span></div>
          <div style="display:flex"><span class="num" style="width:44px;text-align:right;padding-right:16px;color:var(--fg-3)">10</span><span style="padding-left:16px">&nbsp;&nbsp;<span style="color:var(--kw)">join</span> <span style="color:var(--id)">tpch</span>.<span style="color:var(--id)">sf100</span>.<span style="color:var(--id)">nation</span> <span style="color:var(--id)">n</span> <span style="color:var(--kw)">on</span> <span style="color:var(--id)">n</span>.<span style="color:var(--id)">nationkey</span> = <span style="color:var(--id)">c</span>.<span style="color:var(--id)">nationkey</span></span></div>
          <div style="display:flex"><span class="num" style="width:44px;text-align:right;padding-right:16px;color:var(--fg-3)">11</span><span style="padding-left:16px"><span style="color:var(--kw)">where</span> <span style="color:var(--id)">o</span>.<span style="color:var(--id)">orderdate</span> &gt;= <span style="color:var(--kw)">date</span> <span style="color:var(--str)">'1995-01-01'</span></span></div>
          <div style="display:flex"><span class="num" style="width:44px;text-align:right;padding-right:16px;color:var(--fg-3)">12</span><span style="padding-left:16px"><span style="color:var(--kw)">group by</span> <span style="color:var(--num)">1</span> <span style="color:var(--kw)">order by</span> <span style="color:var(--id)">revenue</span> <span style="color:var(--kw)">desc</span>;</span></div>
        </div>
        <div class="row" style="gap:14px;height:22px;padding-left:60px;margin-top:12px;color:var(--fg-3)">
          <span class="row" style="gap:6px"><svg class="ic12"><use href="#i-play"/></svg>Run</span>
        </div>
        <div class="mono" style="font-size:13px;line-height:22px;color:var(--cmt);padding-left:60px">-- scratch: check nation totals against the daily rollup</div>
      </div>

      <div style="background:var(--line-strong)"></div>

      <!-- results -->
      <div style="display:grid;grid-template-rows:36px 1fr 30px;min-height:0;background:var(--s0)">

        <!-- results rail: same 36px, gives the split a shoulder -->
        <div class="row" style="gap:10px;padding:0 12px;background:var(--s1);border-bottom:1px solid var(--line-strong)">
          <span style="width:7px;height:7px;border-radius:50%;background:var(--ok)"></span>
          <span>200 rows</span>
          <span style="color:var(--fg-3)">&middot;</span>
          <span style="color:var(--fg-2)">1.4 s</span>
          <span style="color:var(--fg-3)">&middot;</span>
          <span style="color:var(--fg-2)">12.8 MB</span>
          <span style="flex:1"></span>
          <span class="row" style="gap:6px;height:24px;padding:0 8px;border-radius:6px;color:var(--fg-2)"><svg class="ic"><use href="#i-dl"/></svg>Export</span>
          <span class="row" style="gap:6px;height:24px;padding:0 8px;border-radius:6px;background:var(--s2);color:var(--fg)"><svg class="ic"><use href="#i-panel"/></svg>Inspect<kbd class="meta" style="border:1px solid var(--line-strong);border-radius:4px;background:var(--s0);padding:1px 5px;font-family:inherit;margin-left:2px">&#8984;I</kbd></span>
        </div>

        <!-- table: horizontal hairlines only -->
        <div style="overflow:hidden;min-height:0">
          <table style="border-collapse:separate;border-spacing:0;table-layout:fixed;width:100%">
            <tr style="height:30px">
              <th style="width:52px;background:var(--s1);border-bottom:1px solid var(--line-strong);border-right:1px solid var(--line)"></th>
              <th style="width:200px;background:var(--s1);border-bottom:1px solid var(--line-strong);border-right:1px solid var(--line);padding:0 12px;text-align:left"><div class="row" style="gap:8px"><span class="caps ell" style="flex:1">nation</span><span class="meta" style="color:var(--fg-3)">varchar(25)</span></div></th>
              <th style="width:130px;background:var(--s1);border-bottom:1px solid var(--line-strong);border-right:1px solid var(--line);padding:0 12px;text-align:left"><div class="row" style="gap:8px"><span class="caps ell" style="flex:1">orders</span><span class="meta" style="color:var(--fg-3)">bigint</span></div></th>
              <th style="width:140px;background:var(--s1);border-bottom:1px solid var(--line-strong);border-right:1px solid var(--line);padding:0 12px;text-align:left"><div class="row" style="gap:8px"><span class="caps ell" style="flex:1">customers</span><span class="meta" style="color:var(--fg-3)">bigint</span></div></th>
              <th style="width:190px;background:var(--s1);border-bottom:1px solid var(--line-strong);border-right:1px solid var(--line);padding:0 12px;text-align:left"><div class="row" style="gap:8px"><span class="caps ell" style="flex:1">revenue</span><span class="meta" style="color:var(--fg-3)">double</span></div></th>
              <th style="width:150px;background:var(--s1);border-bottom:1px solid var(--line-strong);border-right:1px solid var(--line);padding:0 12px;text-align:left"><div class="row" style="gap:8px"><span class="caps ell" style="flex:1">avg_ship_days</span><span class="meta" style="color:var(--fg-3)">double</span></div></th>
              <th style="background:var(--s1);border-bottom:1px solid var(--line-strong)"></th>
            </tr>
            <!--ROWS-->
          </table>
        </div>

        <!-- peek strip: the inspector, collapsed to one line -->
        <div class="row" style="gap:10px;padding:0 12px;background:var(--s1);border-top:1px solid var(--line-strong)">
          <span class="caps" style="color:var(--fg-3)">revenue</span>
          <span class="meta" style="color:var(--fg-3)">double</span>
          <span style="width:1px;height:14px;background:var(--line-strong)"></span>
          <span class="mono ell" style="flex:1">9070154776.62</span>
          <span class="row" style="gap:6px;color:var(--accent)"><svg class="ic"><use href="#i-panel"/></svg>Inspect row</span>
        </div>
      </div>
    </div>
  </div>

  <!-- ================= 26px status bar ================= -->
  <div class="row meta" style="gap:8px;padding:0 12px;background:var(--s1);border-top:1px solid var(--line-strong);color:var(--fg-3)">
    <span style="width:16px;height:16px;border-radius:50%;border:1px solid var(--line-strong);background:var(--s0);display:inline-flex;align-items:center;justify-content:center;font-size:9px">&#128055;</span>
    <span>Oink</span>
    <span style="flex:1"></span>
    <span>r.dahlen@gmail.com</span>
    <span style="width:1px;height:12px;background:var(--line-strong)"></span>
    <span style="display:inline-flex;color:var(--fg-3)"><svg class="ic12"><use href="#i-moon"/></svg></span>
  </div>
</div>
