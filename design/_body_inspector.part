        <div style="display:grid;grid-template-columns:130px minmax(0,1fr);gap:0 12px;align-items:baseline;padding:7px 4px;border-bottom:1px solid var(--line)"><span class="meta ell" style="color:var(--fg-3)">orders</span><span class="mono ell">600288</span></div>
