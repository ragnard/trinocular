        <th style="width:150px;background:var(--s1);border-bottom:1px solid var(--line-strong);border-right:1px solid var(--line);padding:0 10px;text-align:left"><div class="row" style="gap:8px"><span class="caps ell" style="flex:1">orders</span><span class="meta" style="color:var(--fg-3)">bigint</span></div></th>
        <th style="width:210px;background:var(--s1);border-bottom:1px solid var(--line-strong);border-right:1px solid var(--line);padding:0 10px;text-align:left"><div class="row" style="gap:8px"><span class="caps ell" style="flex:1">revenue</span><span class="meta" style="color:var(--fg-3)">double</span></div></th>
        <th style="background:var(--s1);border-bottom:1px solid var(--line-strong)"></th>
      </tr>
      <tr style="height:30px"><td class="meta num" style="padding:0 10px;text-align:right;color:var(--fg-3);background:var(--s1);border-right:1px solid var(--line);border-bottom:1px solid var(--line)">1</td><td style="padding:0 10px;border-bottom:1px solid var(--line)">ARGENTINA</td><td class="num" style="padding:0 10px;text-align:right;border-bottom:1px solid var(--line)">598412</td><td class="num" style="padding:0 10px;text-align:right;border-bottom:1px solid var(--line)">9048217445.31</td><td style="border-bottom:1px solid var(--line)"></td></tr>
      <tr style="height:30px"><td class="meta num" style="padding:0 10px;text-align:right;color:var(--fg-3);background:var(--s1);border-right:1px solid var(--line);border-bottom:1px solid var(--line)">2</td><td style="padding:0 10px;border-bottom:1px solid var(--line)">BRAZIL</td><td class="num" style="padding:0 10px;text-align:right;border-bottom:1px solid var(--line)">601077</td><td class="num" style="padding:0 10px;text-align:right;border-bottom:1px solid var(--line)">9087445021.08</td><td style="border-bottom:1px solid var(--line)"></td></tr>
