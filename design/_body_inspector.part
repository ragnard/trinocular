      <tr style="height:30px"><td class="meta num" style="padding:0 10px;text-align:right;color:var(--fg-3);background:var(--s1);border-right:1px solid var(--line);border-bottom:1px solid var(--line)">4</td><td style="padding:0 10px;border-bottom:1px solid var(--line)">CHINA</td><td class="num" style="padding:0 10px;text-align:right;border-bottom:1px solid var(--line)">599940</td><td class="num" style="padding:0 10px;text-align:right;border-bottom:1px solid var(--line)">9065000021.14</td><td style="border-bottom:1px solid var(--line)"></td></tr>
      <tr style="height:30px"><td class="meta num" style="padding:0 10px;text-align:right;color:var(--fg-3);background:var(--s1);border-right:1px solid var(--line);border-bottom:1px solid var(--line)">5</td><td style="padding:0 10px;border-bottom:1px solid var(--line)">EGYPT</td><td class="num" style="padding:0 10px;text-align:right;border-bottom:1px solid var(--line)">600116</td><td class="num" style="padding:0 10px;text-align:right;border-bottom:1px solid var(--line)">9059116774.02</td><td style="border-bottom:1px solid var(--line)"></td></tr>
      <tr style="height:30px"><td class="meta num" style="padding:0 10px;text-align:right;color:var(--fg-3);background:var(--s1);border-right:1px solid var(--line);border-bottom:1px solid var(--line)">6</td><td style="padding:0 10px;border-bottom:1px solid var(--line)">ETHIOPIA</td><td class="num" style="padding:0 10px;text-align:right;border-bottom:1px solid var(--line)">598850</td><td class="num" style="padding:0 10px;text-align:right;border-bottom:1px solid var(--line)">9042771010.55</td><td style="border-bottom:1px solid var(--line)"></td></tr>
      <tr style="height:30px"><td class="meta num" style="padding:0 10px;text-align:right;color:var(--fg-3);background:var(--s1);border-right:1px solid var(--line);border-bottom:1px solid var(--line)">7</td><td style="padding:0 10px;border-bottom:1px solid var(--line)">FRANCE</td><td class="num" style="padding:0 10px;text-align:right;border-bottom:1px solid var(--line)">600464</td><td class="num" style="padding:0 10px;text-align:right;border-bottom:1px solid var(--line)">9072458991.37</td><td style="border-bottom:1px solid var(--line)"></td></tr>
