
<div class="warm" style="width:1440px;height:900px;background:var(--s2);color:var(--fg);padding:8px;display:grid;grid-template-rows:1fr 22px;gap:6px">

  <div style="display:grid;grid-template-columns:264px 1fr 420px;gap:8px;min-height:0">

    <!-- ---------- schema card ---------- -->
    <div style="background:var(--s0);border:1px solid var(--line-strong);border-radius:8px;overflow:hidden;display:flex;flex-direction:column;min-height:0">
      <div class="row" style="gap:8px;height:36px;padding:0 12px;border-bottom:1px solid var(--line);color:var(--fg-3);flex:none">
        <svg class="ic"><use href="#i-search"/></svg>
        <span style="flex:1">Filter schema&hellip;</span>
      </div>
      <div class="row meta" style="gap:6px;height:26px;padding:0 12px;color:var(--fg-3);flex:none">
        <svg class="ic12"><use href="#i-db"/></svg><span>analytics-prod</span>
      </div>
      <div style="flex:1;min-height:0;overflow:hidden;padding:0 6px 8px">
        <div class="row" style="gap:6px;height:26px;padding:0 8px;border-radius:6px"><svg class="ic12" style="color:var(--fg-3);transform:rotate(90deg)"><use href="#i-right"/></svg><svg class="ic" style="color:var(--fg-3)"><use href="#i-db"/></svg><span class="ell">tpch</span></div>
        <div style="padding-left:14px">
          <div class="row" style="gap:6px;height:26px;padding:0 8px;border-radius:6px"><svg class="ic12" style="color:var(--fg-3)"><use href="#i-right"/></svg><svg class="ic" style="color:var(--fg-3)"><use href="#i-box"/></svg><span class="ell">sf1</span></div>
          <div class="row" style="gap:6px;height:26px;padding:0 8px;border-radius:6px"><svg class="ic12" style="color:var(--fg-3);transform:rotate(90deg)"><use href="#i-right"/></svg><svg class="ic" style="color:var(--fg-3)"><use href="#i-box"/></svg><span class="ell">sf100</span></div>
          <div style="padding-left:14px">
            <div class="row" style="gap:6px;height:26px;padding:0 8px;border-radius:6px"><svg class="ic12" style="color:var(--fg-3)"><use href="#i-right"/></svg><svg class="ic" style="color:var(--fg-3)"><use href="#i-table"/></svg><span class="ell">customer</span></div>
            <div class="row" style="gap:6px;height:26px;padding:0 8px;border-radius:6px;background:var(--accent-bg);box-shadow:inset 2px 0 0 var(--accent)"><svg class="ic12" style="color:var(--fg-3);transform:rotate(90deg)"><use href="#i-right"/></svg><svg class="ic" style="color:var(--accent)"><use href="#i-table"/></svg><span class="ell">lineitem</span></div>
            <div style="padding-left:14px">
              <div class="row" style="gap:6px;height:26px;padding:0 8px"><span style="width:12px"></span><svg class="ic" style="color:var(--fg-3)"><use href="#i-type"/></svg><span class="ell" style="flex:1">orderkey</span><span class="meta" style="color:var(--fg-3)">bigint</span></div>
              <div class="row" style="gap:6px;height:26px;padding:0 8px"><span style="width:12px"></span><svg class="ic" style="color:var(--fg-3)"><use href="#i-type"/></svg><span class="ell" style="flex:1">partkey</span><span class="meta" style="color:var(--fg-3)">bigint</span></div>
              <div class="row" style="gap:6px;height:26px;padding:0 8px"><span style="width:12px"></span><svg class="ic" style="color:var(--fg-3)"><use href="#i-type"/></svg><span class="ell" style="flex:1">extendedprice</span><span class="meta" style="color:var(--fg-3)">double</span></div>
              <div class="row" style="gap:6px;height:26px;padding:0 8px"><span style="width:12px"></span><svg class="ic" style="color:var(--fg-3)"><use href="#i-type"/></svg><span class="ell" style="flex:1">discount</span><span class="meta" style="color:var(--fg-3)">double</span></div>
              <div class="row" style="gap:6px;height:26px;padding:0 8px"><span style="width:12px"></span><svg class="ic" style="color:var(--fg-3)"><use href="#i-type"/></svg><span class="ell" style="flex:1">shipdate</span><span class="meta" style="color:var(--fg-3)">date</span></div>
            </div>
            <div class="row" style="gap:6px;height:26px;padding:0 8px;border-radius:6px"><svg class="ic12" style="color:var(--fg-3)"><use href="#i-right"/></svg><svg class="ic" style="color:var(--fg-3)"><use href="#i-table"/></svg><span class="ell">orders</span></div>
            <div class="row" style="gap:6px;height:26px;padding:0 8px;border-radius:6px"><svg class="ic12" style="color:var(--fg-3)"><use href="#i-right"/></svg><svg class="ic" style="color:var(--fg-3)"><use href="#i-table"/></svg><span class="ell">nation</span></div>
            <div class="row" style="gap:6px;height:26px;padding:0 8px;border-radius:6px"><svg class="ic12" style="color:var(--fg-3)"><use href="#i-right"/></svg><svg class="ic" style="color:var(--fg-3)"><use href="#i-table"/></svg><span class="ell">region</span></div>
          </div>
          <div class="row" style="gap:6px;height:26px;padding:0 8px;border-radius:6px"><svg class="ic12" style="color:var(--fg-3)"><use href="#i-right"/></svg><svg class="ic" style="color:var(--fg-3)"><use href="#i-box"/></svg><span class="ell">tiny</span></div>
        </div>
        <div class="row" style="gap:6px;height:26px;padding:0 8px;border-radius:6px"><svg class="ic12" style="color:var(--fg-3)"><use href="#i-right"/></svg><svg class="ic" style="color:var(--fg-3)"><use href="#i-db"/></svg><span class="ell">iceberg</span></div>
        <div class="row" style="gap:6px;height:26px;padding:0 8px;border-radius:6px"><svg class="ic12" style="color:var(--fg-3)"><use href="#i-right"/></svg><svg class="ic" style="color:var(--fg-3)"><use href="#i-db"/></svg><span class="ell">hive</span></div>
        <div class="row" style="gap:6px;height:26px;padding:0 8px;border-radius:6px"><svg class="ic12" style="color:var(--fg-3)"><use href="#i-right"/></svg><svg class="ic" style="color:var(--fg-3)"><use href="#i-db"/></svg><span class="ell">system</span></div>
      </div>
    </div>

    <!-- ---------- document + results cards ---------- -->
    <div style="display:grid;grid-template-rows:330px 8px 1fr;min-width:0;min-height:0">

      <!-- editor card -->
      <div style="background:var(--s0);border:1px solid var(--line-strong);border-radius:8px;overflow:hidden;display:flex;flex-direction:column">
        <div class="row" style="gap:2px;height:36px;padding:0 10px;border-bottom:1px solid var(--line);flex:none">
          <span class="row" style="gap:6px;height:24px;padding:0 8px;border-radius:6px;background:var(--s2);font-weight:600"><svg class="ic" style="color:var(--fg-3)"><use href="#i-file"/></svg>revenue-by-nation.sql<svg class="ic12" style="color:var(--fg-3)"><use href="#i-down"/></svg></span>
          <span style="width:1px;height:16px;background:var(--line-strong);margin:0 8px"></span>
          <span class="row" style="gap:6px;height:24px;padding:0 8px;border-radius:6px;color:var(--fg-2)"><svg class="ic" style="color:var(--fg-3)"><use href="#i-db"/></svg>analytics-prod<svg class="ic12" style="color:var(--fg-3)"><use href="#i-down"/></svg></span>
          <span style="flex:1"></span>
          <span class="row" style="gap:6px;color:var(--fg-3)"><kbd class="meta" style="border:1px solid var(--line-strong);border-radius:4px;background:var(--s1);padding:1px 5px;font-family:inherit">&#8984;P</kbd>Switch file</span>
        </div>
        <div style="flex:1;overflow:hidden;padding:10px 0 0;position:relative">
          <div class="row" style="gap:14px;height:22px;padding-left:60px;color:var(--fg-3)">
            <span class="row" style="gap:6px;color:var(--accent)"><svg class="ic12"><use href="#i-play"/></svg>Run</span>
            <span class="row" style="gap:6px"><svg class="ic12"><use href="#i-list"/></svg>200 rows</span>
          </div>
          <div class="mono" style="font-size:13px;line-height:22px;position:relative">
            <div style="position:absolute;left:52px;top:0;bottom:0;width:2px;background:var(--accent);opacity:.45;border-radius:1px"></div>
            <div style="display:flex"><span class="num" style="width:44px;text-align:right;padding-right:16px;color:var(--fg-3)">1</span><span style="padding-left:16px"><span style="color:var(--kw)">select</span></span></div>
            <div style="display:flex"><span class="num" style="width:44px;text-align:right;padding-right:16px;color:var(--fg-3)">2</span><span style="padding-left:16px">&nbsp;&nbsp;<span style="color:var(--id)">n</span>.<span style="color:var(--id)">name</span> <span style="color:var(--kw)">as</span> <span style="color:var(--id)">nation</span>,</span></div>
            <div style="display:flex"><span class="num" style="width:44px;text-align:right;padding-right:16px;color:var(--fg-3)">3</span><span style="padding-left:16px">&nbsp;&nbsp;<span style="color:var(--fn)">count</span>(<span style="color:var(--kw)">distinct</span> <span style="color:var(--id)">o</span>.<span style="color:var(--id)">orderkey</span>) <span style="color:var(--kw)">as</span> <span style="color:var(--id)">orders</span>,</span></div>
            <div style="display:flex"><span class="num" style="width:44px;text-align:right;padding-right:16px;color:var(--fg-3)">4</span><span style="padding-left:16px">&nbsp;&nbsp;<span style="color:var(--fn)">sum</span>(<span style="color:var(--id)">l</span>.<span style="color:var(--id)">extendedprice</span> * (<span style="color:var(--num)">1</span> - <span style="color:var(--id)">l</span>.<span style="color:var(--id)">discount</span>)) <span style="color:var(--kw)">as</span> <span style="color:var(--id)">revenue</span>,</span></div>
            <div style="display:flex"><span class="num" style="width:44px;text-align:right;padding-right:16px;color:var(--fg-3)">5</span><span style="padding-left:16px">&nbsp;&nbsp;<span style="color:var(--fn)">arbitrary</span>(<span style="color:var(--id)">c</span>) <span style="color:var(--kw)">as</span> <span style="color:var(--id)">top_customer</span></span></div>
            <div style="display:flex"><span class="num" style="width:44px;text-align:right;padding-right:16px;color:var(--fg-3)">6</span><span style="padding-left:16px"><span style="color:var(--kw)">from</span> <span style="color:var(--id)">tpch</span>.<span style="color:var(--id)">sf100</span>.<span style="color:var(--id)">lineitem</span> <span style="color:var(--id)">l</span></span></div>
            <div style="display:flex"><span class="num" style="width:44px;text-align:right;padding-right:16px;color:var(--fg-3)">7</span><span style="padding-left:16px">&nbsp;&nbsp;<span style="color:var(--kw)">join</span> <span style="color:var(--id)">tpch</span>.<span style="color:var(--id)">sf100</span>.<span style="color:var(--id)">orders</span> <span style="color:var(--id)">o</span> <span style="color:var(--kw)">on</span> <span style="color:var(--id)">o</span>.<span style="color:var(--id)">orderkey</span> = <span style="color:var(--id)">l</span>.<span style="color:var(--id)">orderkey</span></span></div>
            <div style="display:flex"><span class="num" style="width:44px;text-align:right;padding-right:16px;color:var(--fg-3)">8</span><span style="padding-left:16px">&nbsp;&nbsp;<span style="color:var(--kw)">join</span> <span style="color:var(--id)">tpch</span>.<span style="color:var(--id)">sf100</span>.<span style="color:var(--id)">customer</span> <span style="color:var(--id)">c</span> <span style="color:var(--kw)">on</span> <span style="color:var(--id)">c</span>.<span style="color:var(--id)">custkey</span> = <span style="color:var(--id)">o</span>.<span style="color:var(--id)">custkey</span></span></div>
            <div style="display:flex"><span class="num" style="width:44px;text-align:right;padding-right:16px;color:var(--fg-3)">9</span><span style="padding-left:16px">&nbsp;&nbsp;<span style="color:var(--kw)">join</span> <span style="color:var(--id)">tpch</span>.<span style="color:var(--id)">sf100</span>.<span style="color:var(--id)">nation</span> <span style="color:var(--id)">n</span> <span style="color:var(--kw)">on</span> <span style="color:var(--id)">n</span>.<span style="color:var(--id)">nationkey</span> = <span style="color:var(--id)">c</span>.<span style="color:var(--id)">nationkey</span></span></div>
            <div style="display:flex"><span class="num" style="width:44px;text-align:right;padding-right:16px;color:var(--fg-3)">10</span><span style="padding-left:16px"><span style="color:var(--kw)">where</span> <span style="color:var(--id)">o</span>.<span style="color:var(--id)">orderdate</span> &gt;= <span style="color:var(--kw)">date</span> <span style="color:var(--str)">'1995-01-01'</span></span></div>
            <div style="display:flex"><span class="num" style="width:44px;text-align:right;padding-right:16px;color:var(--fg-3)">11</span><span style="padding-left:16px"><span style="color:var(--kw)">group by</span> <span style="color:var(--num)">1</span> <span style="color:var(--kw)">order by</span> <span style="color:var(--id)">revenue</span> <span style="color:var(--kw)">desc</span>;</span></div>
          </div>
        </div>
      </div>

      <div></div>

      <!-- results card: the table keeps this pane, the inspector gets its own -->
      <div style="background:var(--s0);border:1px solid var(--line-strong);border-radius:8px;overflow:hidden;display:flex;flex-direction:column;min-height:0">
        <div class="row" style="gap:10px;height:36px;padding:0 10px 0 12px;border-bottom:1px solid var(--line);flex:none">
          <span style="width:7px;height:7px;border-radius:50%;background:var(--ok)"></span>
          <span>200 rows</span>
          <span style="color:var(--fg-3)">&middot;</span><span style="color:var(--fg-2)">1.4 s</span>
          <span style="color:var(--fg-3)">&middot;</span><span style="color:var(--fg-2)">12.8 MB</span>
          <span style="flex:1"></span>
          <span class="row" style="gap:6px;height:24px;padding:0 8px;border-radius:6px;color:var(--fg-2)"><svg class="ic"><use href="#i-dl"/></svg>Export</span>
          <span class="row" style="gap:6px;height:24px;padding:0 8px;border-radius:6px;background:var(--accent-bg);color:var(--accent)"><svg class="ic"><use href="#i-panel"/></svg>Inspector<kbd class="meta" style="border:1px solid var(--accent-line);border-radius:4px;padding:1px 5px;font-family:inherit;margin-left:2px">&#8984;I</kbd></span>
        </div>
        <div style="flex:1;min-height:0;overflow:hidden">
          <table style="border-collapse:separate;border-spacing:0;table-layout:fixed;width:100%">
            <!--HEADER-->
            <!--ROWS-->
          </table>
        </div>
      </div>
    </div>

    <!-- ---------- inspector card: full window height, so a block selection
         reads as a stack of whole documents rather than a peephole ---------- -->
    <div style="background:var(--s0);border:1px solid var(--line-strong);border-radius:8px;overflow:hidden;display:flex;flex-direction:column;min-height:0">
      <div class="row" style="gap:8px;height:36px;padding:0 6px 0 12px;border-bottom:1px solid var(--line);flex:none">
        <svg class="ic" style="color:var(--fg-3)"><use href="#i-panel"/></svg>
        <span class="ell" style="flex:1">5 rows &times; 4 fields</span>
        <span class="row" style="width:24px;height:24px;justify-content:center;border-radius:6px;color:var(--fg-3)" title="Copy selection as JSON"><svg class="ic"><use href="#i-copy"/></svg></span>
        <span class="row" style="width:24px;height:24px;justify-content:center;border-radius:6px;color:var(--fg-3)"><svg class="ic"><use href="#i-x"/></svg></span>
      </div>
      <div class="row" style="gap:8px;height:24px;margin:8px 12px 6px;padding:0 8px;border:1px solid var(--line-strong);border-radius:6px;color:var(--fg-3);flex:none">
        <svg class="ic12"><use href="#i-search"/></svg><span style="flex:1">Filter fields&hellip;</span>
      </div>

      <div style="flex:1;min-height:0;overflow:hidden">
        <div class="row" style="gap:8px;height:24px;padding:0 12px;background:var(--s2);border-top:1px solid var(--line);border-bottom:1px solid var(--line)"><span class="caps" style="color:var(--fg-2)">Row 3</span><span style="flex:1"></span><span class="row" style="color:var(--fg-3)"><svg class="ic12"><use href="#i-copy"/></svg></span></div>
        <div style="display:grid;grid-template-columns:140px minmax(0,1fr);gap:0 10px;padding:6px 12px;border-bottom:1px solid var(--line)"><span class="ell" style="color:var(--fg-2)">nation</span><span class="mono ell">CANADA</span></div>
        <div style="display:grid;grid-template-columns:140px minmax(0,1fr);gap:0 10px;padding:6px 12px;border-bottom:1px solid var(--line)"><span class="ell" style="color:var(--fg-2)">orders</span><span class="mono ell">600288</span></div>
        <div style="display:grid;grid-template-columns:140px minmax(0,1fr);gap:0 10px;padding:6px 12px;border-bottom:1px solid var(--line)"><span class="ell" style="color:var(--fg-2)">distinct_customers</span><span class="mono ell">59988</span></div>
        <div style="display:grid;grid-template-columns:140px minmax(0,1fr);gap:0 10px;padding:6px 12px;border-bottom:1px solid var(--line)"><span class="ell" style="color:var(--fg-2)">revenue</span><span class="mono ell">9070154776.62</span></div>

        <div class="row" style="gap:8px;height:24px;padding:0 12px;background:var(--s2);border-bottom:1px solid var(--line)"><span class="caps" style="color:var(--fg-2)">Row 4</span><span style="flex:1"></span><span class="row" style="color:var(--fg-3)"><svg class="ic12"><use href="#i-copy"/></svg></span></div>
        <div style="display:grid;grid-template-columns:140px minmax(0,1fr);gap:0 10px;padding:6px 12px;border-bottom:1px solid var(--line)"><span class="ell" style="color:var(--fg-2)">nation</span><span class="mono ell">CHINA</span></div>
        <div style="display:grid;grid-template-columns:140px minmax(0,1fr);gap:0 10px;padding:6px 12px;border-bottom:1px solid var(--line)"><span class="ell" style="color:var(--fg-2)">orders</span><span class="mono ell">599940</span></div>
        <div style="display:grid;grid-template-columns:140px minmax(0,1fr);gap:0 10px;padding:6px 12px;border-bottom:1px solid var(--line)"><span class="ell" style="color:var(--fg-2)">distinct_customers</span><span class="mono ell">60104</span></div>
        <div style="display:grid;grid-template-columns:140px minmax(0,1fr);gap:0 10px;padding:6px 12px;border-bottom:1px solid var(--line)"><span class="ell" style="color:var(--fg-2)">revenue</span><span class="mono ell">9065000021.14</span></div>

        <div class="row" style="gap:8px;height:24px;padding:0 12px;background:var(--s2);border-bottom:1px solid var(--line)"><span class="caps" style="color:var(--fg-2)">Row 5</span><span style="flex:1"></span><span class="row" style="color:var(--fg-3)"><svg class="ic12"><use href="#i-copy"/></svg></span></div>
        <div style="display:grid;grid-template-columns:140px minmax(0,1fr);gap:0 10px;padding:6px 12px;border-bottom:1px solid var(--line)"><span class="ell" style="color:var(--fg-2)">nation</span><span class="mono ell">EGYPT</span></div>
        <div style="display:grid;grid-template-columns:140px minmax(0,1fr);gap:0 10px;padding:6px 12px;border-bottom:1px solid var(--line)"><span class="ell" style="color:var(--fg-2)">orders</span><span class="mono ell">600116</span></div>
        <div style="display:grid;grid-template-columns:140px minmax(0,1fr);gap:0 10px;padding:6px 12px;border-bottom:1px solid var(--line)"><span class="ell" style="color:var(--fg-2)">distinct_customers</span><span class="mono ell">59882</span></div>
        <div style="display:grid;grid-template-columns:140px minmax(0,1fr);gap:0 10px;padding:6px 12px;border-bottom:1px solid var(--line)"><span class="ell" style="color:var(--fg-2)">revenue</span><span class="mono ell">9059116774.02</span></div>

        <div class="row" style="gap:8px;height:24px;padding:0 12px;background:var(--s2);border-bottom:1px solid var(--line)"><span class="caps" style="color:var(--fg-2)">Row 6</span><span style="flex:1"></span><span class="row" style="color:var(--fg-3)"><svg class="ic12"><use href="#i-copy"/></svg></span></div>
        <div style="display:grid;grid-template-columns:140px minmax(0,1fr);gap:0 10px;padding:6px 12px;border-bottom:1px solid var(--line)"><span class="ell" style="color:var(--fg-2)">nation</span><span class="mono ell">ETHIOPIA</span></div>
        <div style="display:grid;grid-template-columns:140px minmax(0,1fr);gap:0 10px;padding:6px 12px;border-bottom:1px solid var(--line)"><span class="ell" style="color:var(--fg-2)">orders</span><span class="mono ell">598850</span></div>
        <div style="display:grid;grid-template-columns:140px minmax(0,1fr);gap:0 10px;padding:6px 12px;border-bottom:1px solid var(--line)"><span class="ell" style="color:var(--fg-2)">distinct_customers</span><span class="mono ell">59771</span></div>
        <div style="display:grid;grid-template-columns:140px minmax(0,1fr);gap:0 10px;padding:6px 12px;border-bottom:1px solid var(--line)"><span class="ell" style="color:var(--fg-2)">revenue</span><span class="mono ell">9042771010.55</span></div>

        <div class="row" style="gap:8px;height:24px;padding:0 12px;background:var(--s2);border-bottom:1px solid var(--line)"><span class="caps" style="color:var(--fg-2)">Row 7</span><span style="flex:1"></span><span class="row" style="color:var(--fg-3)"><svg class="ic12"><use href="#i-copy"/></svg></span></div>
        <div style="display:grid;grid-template-columns:140px minmax(0,1fr);gap:0 10px;padding:6px 12px;border-bottom:1px solid var(--line)"><span class="ell" style="color:var(--fg-2)">nation</span><span class="mono ell">FRANCE</span></div>
        <div style="display:grid;grid-template-columns:140px minmax(0,1fr);gap:0 10px;padding:6px 12px;border-bottom:1px solid var(--line)"><span class="ell" style="color:var(--fg-2)">orders</span><span class="mono ell">600464</span></div>
        <div style="display:grid;grid-template-columns:140px minmax(0,1fr);gap:0 10px;padding:6px 12px;border-bottom:1px solid var(--line)"><span class="ell" style="color:var(--fg-2)">distinct_customers</span><span class="mono ell">60220</span></div>
        <div style="display:grid;grid-template-columns:140px minmax(0,1fr);gap:0 10px;padding:6px 12px;border-bottom:1px solid var(--line)"><span class="ell" style="color:var(--fg-2)">revenue</span><span class="mono ell">9072458991.37</span></div>
      </div>
    </div>
  </div>

  <!-- status strip -->
