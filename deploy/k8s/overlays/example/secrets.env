# What config.yaml's ${...} references resolve to. Replace every value before
# deploying, and keep the real file out of version control (or under SOPS or
# sealed-secrets, which both produce a Secret this overlay can reference
# instead of generating one).
#
# The cookie secret placeholder is shorter than the 32 characters the server
# requires on purpose: deployed as it is, Trinette refuses to start, rather
# than running behind a session key that is printed in a public repository.
#
#   openssl rand -hex 32
COOKIE_SECRET=replace-me
OIDC_CLIENT_SECRET=replace-me
