{
  "name": "trinette",
  "private": true,
  "version": "0.0.1",
  "license": "Apache-2.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc -p perf",
    "test": "bun test src",
    "perf": "bun perf/run.ts",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "monaco-editor": "^0.55.1"
  },
  "devDependencies": {
    "@lucide/svelte": "^1.7.0",
    "@sveltejs/adapter-auto": "^7.0.1",
    "@sveltejs/adapter-node": "^5.5.4",
    "@sveltejs/kit": "^2.55.0",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@types/bun": "^1.3.11",
    "@types/node": "^25.5.0",
    "iovalkey": "^0.4.0",
    "marked": "^18.0.13",
    "monaco-language-trino": "workspace:*",
    "openid-client": "^6.8.2",
    "pino": "^10.3.1",
    "prettier": "^3.9.8",
    "prettier-plugin-svelte": "^4.1.1",
    "puppeteer-core": "^25.11.0",
    "svelte": "^5.55.1",
    "svelte-check": "^4.4.6",
    "typescript": "^5.9.3",
    "vite": "^8.0.3",
    "zod": "^4.3.6"
  }
}
