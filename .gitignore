# Iosevka release archive and the TTF extracted from it, both rebuildable by
# `make fonts`. The two built .woff2 under src/lib/assets are checked in on
# purpose: a build should not need 84 MB of network and a python toolchain to
# produce two files that change only when IOSEVKA_VERSION does.
.fontbuild/

# Local-only: the dev/preview configs hold cookie and client secrets, and
# hack/ holds a TLS key and connector properties for a local stack. The
# example is the one config file that is documentation rather than a secret.
/config.*.yaml
!/config.example.yaml
/hack/

# Worktrees and other per-machine state from Claude Code sessions.
/.claude/worktrees/
